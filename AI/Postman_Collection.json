              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"budget\": 5000,\n  \"purpose\": \"gaming setup\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "AI breaks budget into multiple products. E.g. Mouse ₹1000 + Keyboard ₹2000 + Headphones ₹1800 = ₹4800 (saved ₹200)"
          }
        },
        {
          "name": "POST /ai/smart-budget — Study Desk ₹3000",
