    {
      "name": "📝 7. Product Description Generator",
      "item": [
        {
          "name": "POST /ai/generate-description",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/generate-description",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Nike Air Max Running Shoes\",\n  \"category\": \"Footwear\",\n  \"basicDescription\": \"Comfortable running shoes with air cushioning\",\n  \"price\": 5999\n}",
              "options": { "raw": { "language": "json" } }
