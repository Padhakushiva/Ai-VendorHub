{
  "info": {
    "name": "AI VendorHub — Complete AI Features",
    "description": "Complete Postman collection for all AI service endpoints including Smart Search, Conversational Shopping, Similar Products, Product Comparison, Smart Budget, and Mood Shopping.",
    "_postman_id": "ai-vendorhub-v3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3005", "type": "string" },
    { "key": "authToken", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" },
    { "key": "productId1", "value": "PRODUCT_ID_1_HERE", "type": "string" },
    { "key": "productId2", "value": "PRODUCT_ID_2_HERE", "type": "string" }
  ],
  "item": [
    {
      "name": "🏥 Health & Monitoring",
      "item": [
        {
          "name": "GET / — Service Info",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/",
            "description": "Service version, all features, and all available endpoints."
          }
        },
        {
          "name": "GET /health — Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Returns service status, uptime, feature flags, and LLM metrics."
          }
        },
        {
          "name": "GET /ai/metrics — Detailed LLM Metrics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ai/metrics",
            "description": "Per-endpoint LLM call stats: success rate, avg latency, failures, timeouts."
          }
        },
        {
          "name": "POST /ai/feature-flags — Toggle LLM Features",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/feature-flags",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flag\": \"LLM_ENABLED\",\n  \"enabled\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Toggle any LLM feature on/off at runtime. Flags: LLM_ENABLED, LLM_SEARCH_INTENT, LLM_DESCRIPTION_GENERATOR, LLM_CATEGORY_SUGGESTION, LLM_REVIEW_SUMMARY, LLM_AGENT_TOOLS"
          }
        }
      ]
    },
    {
      "name": "🔍 1. AI Smart Search",
      "item": [
        {
          "name": "POST /ai/search-intent — Gaming under ₹2000",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/search-intent",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"gaming product under 2000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "AI extracts keyword='gaming', maxPrice=2000. Then uses MongoDB $text search on title + description."
          }
        },
        {
          "name": "POST /ai/search-intent — Cheap Headphones",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/search-intent",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"cheap headphones\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "POST /ai/search-intent — Study Setup Products",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/search-intent",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"products for study setup\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "POST /ai/search-intent — iPhone between 50k-100k latest",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/search-intent",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"iphone between 50000 and 100000 latest\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "💬 2. Conversational Shopping Assistant",
      "item": [
        {
          "name": "POST /ai/chat — Suggest for coding",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/chat",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Suggest products for coding\",\n  \"sessionId\": \"user-session-001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Conversational UX. AI understands intent, searches products, and replies naturally."
          }
        },
        {
          "name": "POST /ai/chat — Best products under ₹1000",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/chat",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Best products under 1000\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "POST /ai/chat — Off-topic (gets politely declined)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/chat",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What is the capital of India?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Non-shopping queries get a polite redirect to shopping."
          }
        }
      ]
    },
    {
      "name": "🔁 3. Similar Product Recommendation",
      "item": [
        {
          "name": "GET /ai/similar/:productId — You May Also Like",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ai/similar/{{productId1}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "description": "Replaces productId1 variable with actual product ID. AI extracts keywords from title/description, finds similar products, ranks by price similarity."
          }
        }
      ]
    },
    {
      "name": "⚖️ 4. AI Product Comparison",
      "item": [
        {
          "name": "POST /ai/compare — Compare 2 Products",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/compare",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productIds\": [\n    \"{{productId1}}\",\n    \"{{productId2}}\"\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Compares price, availability, description. AI analysis tells which is cheaper, better value, and gives recommendation."
          }
        },
        {
          "name": "POST /ai/compare — Compare 3 Products",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/compare",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productIds\": [\n    \"PRODUCT_ID_1\",\n    \"PRODUCT_ID_2\",\n    \"PRODUCT_ID_3\"\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "💰 5. Smart Budget Shopping (UNIQUE!)",
      "item": [
        {
          "name": "POST /ai/smart-budget — Gaming Setup ₹5000",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/ai/smart-budget",
